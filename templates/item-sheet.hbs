<form class="{{cssClass}}" autocomplete="off">

    {{!-- Sheet Header --}}
    {{> "systems/afmbe-left-behind/templates/components/item-sheet-header.hbs"}}

    <section>
        <div class="description-container">
            <div class="item-attribute-sidebar">
                <h2>{{localize 'AFMBE.Item.Attributes.Title'}}</h2>
                <table>
                    <tbody>
                        <tr>
                            <th>{{localize 'AFMBE.Item.Attributes.Equipped'}}</th>
                            <td>
                                <div class="item-attribute-flex-container">
                                    <input type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>{{localize 'AFMBE.Common.Quantity'}}</th>
                            <td><input type="text" name="system.qty" value="{{item.system.qty}}"></td>
                        </tr>
                        <tr>
                            <th>{{localize 'AFMBE.Common.ArmorValue'}}</th>
                            <td><input type="text" name="system.armor_value" value="{{item.system.armor_value}}"></td>
                        </tr>
                        <tr>
                            <th>Armor coverage</th>
                            <td class="afmbe-armor-coverage">
                                <label><input type="checkbox" name="system.armor_coverage.body" {{checked item.system.armor_coverage.body}}>Body</label>
                                <label><input type="checkbox" name="system.armor_coverage.head" {{checked item.system.armor_coverage.head}}>Head</label>
                                <label><input type="checkbox" name="system.armor_coverage.arms" {{checked item.system.armor_coverage.arms}}>Arms</label>
                                <label><input type="checkbox" name="system.armor_coverage.legs" {{checked item.system.armor_coverage.legs}}>Legs</label>
                            </td>
                        </tr>
                        {{#if item.isEmbedded}}
                        <tr><th>Item type</th><td><button type="button" class="convert-to-armor">Convert to Armor</button></td></tr>
                        {{/if}}
                        <tr>
                            <th>{{localize 'AFMBE.Common.EV'}}</th>
                            <td><input type="number" name="system.encumbrance" value="{{item.system.encumbrance}}"></td>
                        </tr>
                        <tr>
                            <th>{{localize 'AFMBE.Common.Cost'}}</th>
                            <td><input type="number" name="system.cost" value="{{item.system.cost}}"></td>
                        </tr>
                        <tr>
                            <th>{{localize 'AFMBE.Common.Availability'}}</th>
                            <td>
                                <select name="system.availability" data-type="String">
                                    {{#selectOptions item.system.availabilityOptions selected=item.system.availability}}
                                    {{/selectOptions}}
                                </select>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            {{> "systems/afmbe-left-behind/templates/components/item-description-sidebar.hbs"}}
        </div>
    </section>
</form>
