<form class="{{cssClass}}" autocomplete="off">

    {{!-- Sheet Header --}}
    {{> "systems/afmbe-left-behind/templates/components/item-sheet-header.hbs"}}
    <section>
        <div class="description-container">
            <div class="item-attribute-sidebar">
                <h2>{{localize 'AFMBE.Item.Attributes.Title'}}</h2>
                <table>
                    <tbody>
                        <tr>
                            <th>{{localize 'AFMBE.Common.Range'}}</th>
                            <td><input type="number" min="0" step="any" name="system.range" value="{{item.system.range}}" placeholder="Normal range in meters"></td>
                        </tr>
                        <tr><th>Penalty per extra range band</th><td><input type="number" min="0" max="20" step="1" name="system.rangePenaltyStep" value="{{item.system.rangePenaltyStep}}"></td></tr>
                        <tr>
                            <th>{{localize 'AFMBE.Common.Damage'}}</th>
                            <td><input type="text" name="system.damage" value="{{item.system.damage}}"></td>
                        </tr>
                        {{#unless (isVehicle)}}
                        <tr>
                            <th>{{localize 'AFMBE.Item.Attributes.DamageMultiplier'}}</th>
                            <td>
                                <select id="damage_cha_multiplier" name="system.damage_cha_multiplier">
                                    {{#selectOptions item.system.damage_characteristics selected=item.system.damage_cha_multiplier}}
                                    {{/selectOptions}}
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <th>{{localize 'AFMBE.Item.Attributes.DamageMultiplierModifier'}}</th>
                            <td>
                                <input type="number" id="damage_cha_multiplier_modifier" name="system.damage_cha_multiplier_modifier" value="{{item.system.damage_cha_multiplier_modifier}}" min="-5" max="5" step="1" data-type="Number">
                            </td>
                        </tr>
                        {{/unless}}
                        <tr>
                            <th>{{localize 'AFMBE.Item.Attributes.DamageType'}}</th>
                            <td>
                                <select id="damageTypeSelect" name="system.damage_type" data-type="String">
                                    {{#selectOptions item.system.damage_types_obj selected=normalizedDamageType}}
                                    {{/selectOptions}}
                                </select>
                            </td>
                        </tr>
                        <tr><th>Attack type</th><td><select name="system.attackMode">{{#selectOptions attackModeOptions selected=item.system.attackMode}}{{/selectOptions}}</select><small>Auto detects older melee weapons from their damage type.</small></td></tr>
                        <tr><th>Melee attack attribute</th><td><select name="system.meleeAttribute">{{#selectOptions meleeAttributeOptions selected=item.system.meleeAttribute}}{{/selectOptions}}</select><small>Auto uses Dexterity for legacy Dexterity weapons, Strength otherwise.</small></td></tr>
                        <tr><th>Swings per Offensive action</th><td><input type="number" name="system.swingsPerAction" min="1" max="20" step="1" value="{{item.system.swingsPerAction}}"></td></tr>
                        <tr><th>Strain per swing</th><td><input type="number" name="system.strain" min="0" max="20" step="1" value="{{item.system.strain}}"></td></tr>
                        <tr><th>Rate of Fire (shots per action)</th><td><input type="number" name="system.rateOfFire" min="1" max="20" step="1" value="{{item.system.rateOfFire}}"></td></tr>
                        <tr><th>Recoil penalty per shot</th><td><input type="number" name="system.recoil" min="0" max="20" step="1" value="{{item.system.recoil}}"></td></tr>
                        <tr>
                            <th>Compatible caliber</th>
                            <td><select class="caliber-presets"><option value="">Custom / current value</option>{{#selectOptions caliberOptions selected=selectedCaliber}}{{/selectOptions}}</select><input class="caliber-value" type="text" name="system.ammo_type" value="{{item.system.ammo_type}}" placeholder="Choose a caliber or enter a custom one"></td>
                        </tr>
                        <tr><th>Magazine inventory</th><td>Use Reload on the character sheet to switch to magazines. Existing capacity remains active until the first reload. Set matching caliber on the weapon, magazine, and loose ammo.</td></tr>
                        <tr>
                            <th>{{localize 'AFMBE.Common.Capacity'}}</th>
                            <td>
                                <div class="item-name-flex-container">
                                    <input type="number" name="system.capacity.value" value="{{item.system.capacity.value}}">
                                    <input type="number" name="system.capacity.max" value="{{item.system.capacity.max}}">
                                </div>
                            </td>
                        </tr>
                        {{# unless (isVehicle)}}
                        <tr>
                            <th>{{localize 'AFMBE.Common.EV'}}</th>
                            <td><input type="number" name="system.encumbrance" value="{{item.system.encumbrance}}"></td>
                        </tr>
                        {{/unless}}
                        <tr>
                            <th>{{localize 'AFMBE.Common.Cost'}}</th>
                            <td><input type="number" name="system.cost" value="{{item.system.cost}}"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            {{> "systems/afmbe-left-behind/templates/components/item-description-sidebar.hbs"}}
        </div>
    </section>
</form>
