<form class="{{cssClass}}" autocomplete="off">

    {{!-- Sheet Header --}}
    {{> "systems/afmbe-left-behind/templates/components/item-sheet-header.hbs"}}
    {{> "systems/afmbe-left-behind/templates/components/weapon-attachment-slots.hbs"}}
    <section>
        <div class="description-container">
            <div class="item-attribute-sidebar">
                <h2>{{localize 'AFMBE.Item.Attributes.Title'}}</h2>
                <table>
                    <tbody>
                        <tr>
                            <th>{{localize 'AFMBE.Common.Range'}}</th>
                            <td><input type="number" min="0" step="any" name="system.range" value="{{item.system.range}}" placeholder="Normal range in meters"></td>
                        </tr>
                        <tr><th>Equipped / ready</th><td>{{#if item.system.equipped}}Yes{{else}}No{{/if}} (toggle on character sheet)</td></tr>
                        {{> "systems/afmbe-left-behind/templates/components/grid-fields.hbs"}}
                        <tr><th>Penalty per extra range band</th><td><input type="number" min="0" max="20" step="1" name="system.rangePenaltyStep" value="{{item.system.rangePenaltyStep}}"></td></tr>
                        <tr>
                            <th>{{localize 'AFMBE.Common.Damage'}}</th>
                            <td><input type="text" name="system.damage" value="{{item.system.damage}}"></td>
                        </tr>
                        {{#unless (isVehicle)}}
                        <tr>
                            <th>{{localize 'AFMBE.Item.Attributes.DamageMultiplier'}}</th>
                            <td>
                                <select id="damage_cha_multiplier" name="system.damage_cha_multiplier">
                                    {{#selectOptions item.system.damage_characteristics selected=item.system.damage_cha_multiplier}}
                                    {{/selectOptions}}
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <th>{{localize 'AFMBE.Item.Attributes.DamageMultiplierModifier'}}</th>
                            <td>
                                <input type="number" id="damage_cha_multiplier_modifier" name="system.damage_cha_multiplier_modifier" value="{{item.system.damage_cha_multiplier_modifier}}" min="-5" max="5" step="1" data-type="Number">
                            </td>
                        </tr>
                        {{/unless}}
                        <tr>
                            <th>{{localize 'AFMBE.Item.Attributes.DamageType'}}</th>
                            <td>
                                <select id="damageTypeSelect" name="system.damage_type" data-type="String">
                                    {{#selectOptions item.system.damage_types_obj selected=normalizedDamageType}}
                                    {{/selectOptions}}
                                </select>
                            </td>
                        </tr>
                        <tr><th>Weapon category</th><td><select name="system.weaponCategory">{{#selectOptions weaponCategoryOptions selected=item.system.weaponCategory}}{{/selectOptions}}</select><small>Auto keeps the existing weapon behavior until you choose a category.</small></td></tr>
                        <tr class="melee-weapon-field" {{#unless showMeleeFields}}style="display:none"{{/unless}}><th>Melee attack attribute</th><td><select name="system.meleeAttribute">{{#selectOptions meleeAttributeOptions selected=item.system.meleeAttribute}}{{/selectOptions}}</select><small>Auto uses Dexterity for legacy Dexterity weapons, Strength otherwise.</small></td></tr>
                        <tr class="melee-weapon-field" {{#unless showMeleeFields}}style="display:none"{{/unless}}><th>Swings per Offensive action</th><td><input type="number" name="system.swingsPerAction" min="1" max="20" step="1" value="{{item.system.swingsPerAction}}"></td></tr>
                        <tr class="melee-weapon-field" {{#unless showMeleeFields}}style="display:none"{{/unless}}><th>Strain per swing</th><td><input type="number" name="system.strain" min="0" max="20" step="1" value="{{item.system.strain}}"></td></tr>
                        <tr class="gun-weapon-field" {{#unless showGunFields}}style="display:none"{{/unless}}><th>Rate of Fire (shots per action)</th><td><input type="number" name="system.rateOfFire" min="1" max="20" step="1" value="{{item.system.rateOfFire}}"></td></tr>
                        <tr class="gun-weapon-field" {{#unless showGunFields}}style="display:none"{{/unless}}><th>Allowed firing modes</th><td><label><input type="checkbox" name="system.allowedFireModes.semi" {{#if allowedFireModes.semi}}checked{{/if}}> Single</label> <label><input type="checkbox" name="system.allowedFireModes.burst" {{#if allowedFireModes.burst}}checked{{/if}}> Burst</label> <label><input type="checkbox" name="system.allowedFireModes.automatic" {{#if allowedFireModes.automatic}}checked{{/if}}> Automatic</label><small>Leave at least one enabled. Existing weapons allow all modes until configured.</small></td></tr>
                        <tr class="gun-weapon-field" {{#unless showGunFields}}style="display:none"{{/unless}}><th>Burst size</th><td><input type="number" name="system.burstSize" min="2" max="10" step="1" value="{{item.system.burstSize}}"></td></tr>
                        <tr class="gun-weapon-field" {{#unless showGunFields}}style="display:none"{{/unless}}><th>Recoil penalty per shot</th><td><input type="number" name="system.recoil" min="0" max="20" step="1" value="{{item.system.recoil}}"></td></tr>
                        <tr class="feed-weapon-field" {{#unless showFeedFields}}style="display:none"{{/unless}}><th>Feed system</th><td><select name="system.feedSystem">{{#selectOptions feedSystemOptions selected=item.system.feedSystem}}{{/selectOptions}}</select><small>Internal, cylinder and single-shot weapons load one loose round per Help action. Auto preserves older capacity behavior.</small></td></tr>
                        <tr class="ranged-weapon-field" {{#unless showRangedFields}}style="display:none"{{/unless}}><th>Compatible caliber / projectile</th>
                            <td><select class="caliber-presets"><option value="">Custom / current value</option>{{#selectOptions caliberOptions selected=selectedCaliber}}{{/selectOptions}}</select><input class="caliber-value" type="text" name="system.ammo_type" value="{{item.system.ammo_type}}" placeholder="Choose a caliber, arrow, or bolt"></td></tr>
                        <tr class="capacity-weapon-field" {{#unless showCapacityFields}}style="display:none"{{/unless}}><th>Loaded rounds / capacity</th><td><div class="item-name-flex-container"><input type="number" name="system.capacity.value" min="0" step="1" value="{{item.system.capacity.value}}"><input type="number" name="system.capacity.max" min="0" step="1" value="{{item.system.capacity.max}}"></div><small>For a bow, arrows remain in loose ammunition; its capacity is not used.</small></td></tr>
                        {{# unless (isVehicle)}}
                        <tr>
                            <th>{{localize 'AFMBE.Common.EV'}}</th>
                            <td><input type="number" name="system.encumbrance" value="{{item.system.encumbrance}}"></td>
                        </tr>
                        {{/unless}}
                        <tr>
                            <th>{{localize 'AFMBE.Common.Cost'}}</th>
                            <td><input type="number" name="system.cost" value="{{item.system.cost}}"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            {{> "systems/afmbe-left-behind/templates/components/item-description-sidebar.hbs"}}
        </div>
    </section>
</form>
