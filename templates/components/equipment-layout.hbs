<div class="afmbe-loadout">
    <section class="afmbe-loadout-slots">
        <h2>Equipped gear</h2>
        {{#if actor.readyGrenades.length}}<div class="afmbe-equip-slot"><strong>Ready grenades</strong>
            {{#each actor.readyGrenades as |grenade|}}<div class="item afmbe-equipped-item" data-item-id="{{grenade._id}}"><img class="afmbe-item-portrait" src="{{grenade.img}}" alt="" draggable="false"><div class="afmbe-equipped-details"><span class="item-name">{{grenade.name}} ×{{grenade.system.qty}}</span><small>Radius {{grenade.system.radius}}</small><button type="button" class="throw-grenade">Throw</button></div></div>{{/each}}
        </div>{{/if}}
        {{#if actor.droppedWeapons.length}}<div class="afmbe-equip-slot"><strong>Dropped at your feet</strong>
            {{#each actor.droppedWeapons as |weapon|}}<div class="item afmbe-equipped-item" data-item-id="{{weapon._id}}"><img class="afmbe-item-portrait" src="{{weapon.img}}" alt="" draggable="false"><div class="afmbe-equipped-details"><span class="item-name">{{weapon.name}}</span><button type="button" class="pick-up-weapon">Pick up (Help action)</button></div></div>{{/each}}
        </div>{{/if}}
        {{#each actor.readyWeaponSlots as |weapon|}}
        <div class="afmbe-equip-slot" data-equip-slot="weapon">
            <strong>Weapon slot</strong>
            {{#if weapon}}
            <div class="item afmbe-equipped-item" data-item-id="{{weapon._id}}"><img class="afmbe-item-portrait" src="{{weapon.img}}" alt="" draggable="false"><div class="afmbe-equipped-details"><span class="item-name">{{weapon.name}}</span>
                <button type="button" class="attack-roll">Attack</button>
                {{#unless weapon.isMeleeWeapon}}{{#unless weapon.isBow}}<button type="button" class="reload-weapon">Reload</button>{{/unless}}{{/unless}}
                {{#if weapon.hasInsertedMagazine}}<button type="button" class="remove-magazine" title="Remove the inserted magazine; its remaining rounds stay inside">Remove mag</button>{{/if}}
                {{#if weapon.canUnload}}<button type="button" class="unload-weapon" title="Return rounds from an internal, cylinder, or single-shot weapon to loose ammunition">Unload rounds</button>{{/if}}
                <button type="button" class="inventory-equip">Unequip</button></div></div>
            {{else}}<span>Drag a weapon here, or use Equip on an item.</span>{{/if}}
        </div>
        {{/each}}
        <div class="afmbe-equip-slot" data-equip-slot="armor"><strong>Worn armor</strong>
            {{#each actor.readyArmor as |armor|}}<div class="item afmbe-equipped-item" data-item-id="{{armor._id}}"><img class="afmbe-item-portrait" src="{{armor.img}}" alt="" draggable="false"><div class="afmbe-equipped-details"><span class="item-name">{{armor.name}}</span>
            <button type="button" class="replenish-armor">Repair</button><button type="button" class="inventory-equip">Unequip</button></div></div>{{/each}}
            <span>Drag armor here to wear it.</span>
        </div>
        <div class="afmbe-equip-slot" data-equip-slot="backpack"><strong>Backpack</strong>
            {{#if actor.readyBackpack}}<div class="item afmbe-equipped-item" data-item-id="{{actor.readyBackpack._id}}"><img class="afmbe-item-portrait" src="{{actor.readyBackpack.img}}" alt="" draggable="false"><div class="afmbe-equipped-details"><span class="item-name">{{actor.readyBackpack.name}}</span><small>{{actor.readyBackpack.system.grid.width}}×{{actor.readyBackpack.system.grid.height}} · {{actor.readyBackpack.system.grid.maxWeight}} lb max</small><button type="button" class="inventory-equip">Take off</button></div></div>
            {{else}}<span>Drag a backpack here or choose one below.</span>
                {{#each actor.backpack as |item|}}<div class="item afmbe-container-option" data-item-id="{{item._id}}"><img class="afmbe-item-portrait" src="{{item.img}}" alt="" draggable="false"><span class="item-name">{{item.name}}</span><button type="button" class="toggle-container-equipped">Wear</button></div>{{/each}}
            {{/if}}
        </div>
        <div class="afmbe-equip-slot" data-equip-slot="rig"><strong>Combat rig</strong>
            {{#if actor.readyRig}}<div class="item afmbe-equipped-item" data-item-id="{{actor.readyRig._id}}"><img class="afmbe-item-portrait" src="{{actor.readyRig.img}}" alt="" draggable="false"><div class="afmbe-equipped-details"><span class="item-name">{{actor.readyRig.name}}</span><small>{{actor.readyRig.system.grid.width}}×{{actor.readyRig.system.grid.height}} · {{actor.readyRig.system.grid.maxWeight}} lb max</small><button type="button" class="inventory-equip">Take off</button></div></div>
            {{else}}<span>Drag a combat rig here or choose one below.</span>
                {{#each actor.rig as |item|}}<div class="item afmbe-container-option" data-item-id="{{item._id}}"><img class="afmbe-item-portrait" src="{{item.img}}" alt="" draggable="false"><span class="item-name">{{item.name}}</span><button type="button" class="toggle-container-equipped">Wear</button></div>{{/each}}
            {{/if}}
        </div>
        {{> "systems/afmbe-left-behind/templates/components/active-effects.hbs"}}
    </section>
    <section class="afmbe-loadout-storage">
        {{> "systems/afmbe-left-behind/templates/components/inventory-grids.hbs"}}
    </section>
</div>
