<div class="afmbe-health-summary">
    <h2>Vitals</h2>
    <div><strong>HP</strong><span>{{actor.system.secondaryAttributes.hp.value}} / {{actor.system.secondaryAttributes.hp.max}}</span></div>
    <div><strong>Endurance</strong><span>{{actor.system.secondaryAttributes.endurance_points.value}} / {{actor.system.secondaryAttributes.endurance_points.max}}</span></div>
    <div><strong>Essence</strong><span>{{actor.system.secondaryAttributes.essence.value}} / {{actor.system.secondaryAttributes.essence.max}}</span></div>
    <div><strong>Speed</strong><span>{{actor.system.secondaryAttributes.speed.halfValue}} m/sec</span></div>
    {{#if actor.healthState.dead}}<p class="afmbe-health-alert">Death confirmed by ZM {{#if isGM}}<button type="button" class="clear-failed-survival">ZM: reverse</button>{{/if}}</p>
    {{else if actor.healthState.critical}}<p class="afmbe-health-alert">Critical · First Aid 13 {{#if actor.healthState.critical.expired}}· rescue deadline expired{{else}}{{#if actor.healthState.critical.combatId}}· rescue by end of next turn{{else}}· ZM tracks rescue timing outside combat{{/if}}{{/if}} {{#if isGM}}{{#if actor.healthState.critical.expired}}<button type="button" class="confirm-death">ZM: confirm death</button>{{else}}{{#unless actor.healthState.critical.combatId}}<button type="button" class="expire-critical">ZM: deadline elapsed</button>{{/unless}}{{/if}}<button type="button" class="extend-critical">ZM: extend deadline</button>{{/if}}</p>
    {{else if actor.healthState.dying}}<p class="afmbe-health-alert">{{#if actor.healthState.stable}}Stable{{else}}Dying · First Aid 9{{/if}} · cannot act until HP rises above −10</p>
    {{else if actor.healthState.semiConscious}}<p class="afmbe-health-alert">{{#if actor.healthState.conscious}}Conscious at {{actor.healthState.hp}} HP · −5 actions{{else}}Semi-conscious · cannot act <button type="button" class="recover-consciousness">Willpower recovery Test</button>{{/if}}</p>
    {{else if actor.healthState.penalty}}<p class="afmbe-health-alert">Severely injured · {{actor.healthState.penalty}} to actions</p>{{/if}}
    {{#if actor.legInjury}}<p class="afmbe-health-alert">Leg Injury · combat movement halved</p>{{/if}}
    {{#if actor.armInjury}}<p class="afmbe-health-alert">Arm Injury · attacks −2</p>{{/if}}
</div>
