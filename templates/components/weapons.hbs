<div class="weapon-table"><h2 class="header-with-button"><button type="button" class="create-item" data-create="weapon">+</button><span>Weapons</span></h2><p>Pick a category on each weapon sheet to show relevant settings. Auto preserves legacy items.</p></div>
<div class="weapon-table"><h2>Melee Weapons</h2><table><thead><tr><th class="table-left-align">Name</th><th>Damage</th><th>Capacity</th><th>EV</th><th></th></tr></thead><tbody>
{{#each actor.meleeWeapons as |item|}}
{{> "systems/afmbe-left-behind/templates/components/weapon-row.hbs" item=item}}
{{/each}}
</tbody></table></div>
<div class="weapon-table"><h2>Firearms</h2><table><thead><tr><th class="table-left-align">Name</th><th>Damage</th><th>Capacity</th><th>EV</th><th></th></tr></thead><tbody>
{{#each actor.firearms as |item|}}
{{> "systems/afmbe-left-behind/templates/components/weapon-row.hbs" item=item}}
{{/each}}
</tbody></table></div>
<div class="weapon-table"><h2>Bows & Crossbows</h2><table><thead><tr><th class="table-left-align">Name</th><th>Damage</th><th>Capacity</th><th>EV</th><th></th></tr></thead><tbody>
{{#each actor.bows as |item|}}
{{> "systems/afmbe-left-behind/templates/components/weapon-row.hbs" item=item}}
{{/each}}
</tbody></table></div>
<div class="weapon-table"><h2>Launchers</h2><table><thead><tr><th class="table-left-align">Name</th><th>Damage</th><th>Capacity</th><th>EV</th><th></th></tr></thead><tbody>
{{#each actor.launchers as |item|}}
{{> "systems/afmbe-left-behind/templates/components/weapon-row.hbs" item=item}}
{{/each}}
</tbody></table></div>
