<div class="item-table"><h2 class="header-with-button"><button type="button" class="create-item" data-create="magazine">+</button><span>Magazines</span></h2><p>Right-click a magazine to load or unload rounds, or drag loose rounds onto it. Manage rounds outside combat.</p><table><thead><tr><th>Name</th><th>Caliber</th><th>Rounds</th><th>Ammo type</th><th></th></tr></thead><tbody>{{#each actor.magazine as |item|}}<tr class="item afmbe-magazine-target" data-item-id="{{item._id}}" title="Drop compatible loose rounds here to load this magazine"><td class="item-name">{{item.name}}</td><td>{{item.system.caliber}}</td><td>{{item.system.rounds}} / {{item.system.capacity}}</td><td>{{item.system.ammoType}}</td><td><button type="button" class="load-magazine">Load</button> {{#if item.system.rounds}}<button type="button" class="unload-magazine">Unload</button>{{/if}} <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a></td></tr>{{/each}}</tbody></table></div>
<div class="item-table"><h2 class="header-with-button"><button type="button" class="create-item" data-create="ammunition">+</button><span>Loose ammunition</span></h2><table><thead><tr><th>Name</th><th>Caliber</th><th>Rounds</th><th>Ammo type</th><th></th></tr></thead><tbody>{{#each actor.ammunition as |item|}}<tr class="item" data-item-id="{{item._id}}"><td class="item-name">{{item.name}}</td><td>{{item.system.caliber}}</td><td>{{item.system.qty}}</td><td>{{item.system.ammoType}}</td><td><a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a></td></tr>{{/each}}</tbody></table></div>
