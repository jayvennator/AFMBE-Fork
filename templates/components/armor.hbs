<div class="item-table">
    <h2 class="header-with-button">
        <button type="button" class="create-item" data-create="armor">+</button>
        <span>{{localize 'AFMBE.Armor.Title'}}</span>
    </h2>
    <table>
        <thead>
            <tr>
                <th class="table-left-align">{{localize 'AFMBE.Common.Name'}}</th>
                <th>{{localize 'AFMBE.Item.Attributes.Equipped'}}</th>
                <th>{{localize 'AFMBE.Common.ArmorValue'}}</th>
                <th>Integrity</th>
                <th>{{localize 'AFMBE.Common.EV'}}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {{#each actor.armor as |item id|}}
            <tr class="item" data-item-id="{{item._id}}">
                <td class="item-name">{{item.name}}</td>
                <td class="table-center-align"><input type="checkbox" class="toggleEquipped" {{checked item.system.equipped}}></td>
                <td class="table-center-align armor-button-cell"><button type="button">{{item.system.armor_value}}</button></td>
                <td class="table-center-align">{{item.system.armor_integrity.value}} / {{item.system.armor_integrity.max}} <button type="button" class="replenish-armor" title="Replenish armor (Help action)">Repair</button></td>
                <td class="table-center-align">{{item.system.encumbrance}}</td>
                <td class="table-center-align"><a class="item-control item-delete" title="{{localize 'AFMBE.Items.Delete'}}"><i class="fas fa-trash"></i></a></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
